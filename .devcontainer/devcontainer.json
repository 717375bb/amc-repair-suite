{
  "name": "AMC Repair Suite",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",

  // Only the frontend dev server is forwarded publicly. The backend
  // (backend/src/server.ts) deliberately binds 127.0.0.1 only and is
  // reached exclusively via Vite's server-side /api proxy (vite.config.ts)
  // — never directly from the browser, in Codespaces or locally. Port 3001
  // is intentionally NOT listed here so it stays container-internal, the
  // same "not reachable from any other machine" posture security.md
  // documents for local runs.
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "AMC Repair Suite",
      "onAutoForward": "openBrowser"
    }
  },

  // Absolute path (via the devcontainer.json ${containerWorkspaceFolder}
  // variable) rather than a relative one — a relative path here silently
  // depends on lifecycle commands running with cwd = the workspace folder,
  // which isn't guaranteed everywhere and is cheap to just not depend on.
  // One-time setup only (installs deps, Playwright Chromium, prepares
  // .env) — confirmed reliable via a real launch's creation log.
  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/setup.sh",

  // Deliberately NOT using postStartCommand to launch the two dev servers
  // — confirmed via a real launch's creation log that it runs and exits 0,
  // but its process context is torn down afterward regardless of nohup/
  // setsid (postStartCommand isn't meant for long-running daemons). The
  // two servers are instead launched by .vscode/tasks.json's
  // runOn: "folderOpen" tasks, which run in a real, persistent VS Code
  // terminal — the one thing confirmed to actually survive.
  "customizations": {
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
