{"nodes": [{"id": "backend_phase2_mxi_writer_spec", "label": "Phase 2 MXI Writer Spec", "file_type": "document", "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_mxi_writer_safety", "label": "MXI Write Safety - Human Approval Only", "file_type": "rationale", "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Safety rules section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-negotiable principle: the writer never runs automatically. Only executes when explicitly approved, one order at a time. No code path exists from inference-computed to MXI-updated without a human approval action. MXI_ENV defaults to stage, never production. Every approve/reject call produces exactly one mxi_writes audit row."}, {"id": "concept_fill_vs_keypress", "label": "DOM .fill() vs Keypress for Masked Date Input Fields", "file_type": "rationale", "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Write path addendum - corruption bug section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Older masked/validated date inputs enforce per-keystroke JS validation that rejects further input once 'full', regardless of selection state. Using .fill() sets the value via DOM input/change event directly, bypassing per-keystroke validation. Click+Backspace+type approach silently corrupted live data twice before this was discovered."}, {"id": "concept_append_only_audit", "label": "Append-Only Audit Trail Pattern", "file_type": "rationale", "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "DB schema section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both esd_inferences and mxi_writes tables are append-only - rows are never updated or deleted. This creates a full audit trail for answering 'why did this date change' and enables diffing results across runs."}, {"id": "concept_gitignore_verification", "label": "git check-ignore -v for Gitignore Validation", "file_type": "rationale", "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Read-path addendum, gitignore bug section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A gitignore entry that visually looks right still needs git check-ignore -v to confirm it actually matches. The .env and discovery-recording.ts entries had literal quote characters wrapping them, meaning the real secrets-holding .env file was not being ignored despite appearing to be in a visual read."}, {"id": "concept_orphan_rate_diagnostic", "label": "Order Orphan Rate - Reporting Coverage Not a Bug", "file_type": "rationale", "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Orphan-rate diagnostic section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "387 CRA-only orphans reflect reporting coverage (Vendor OOR is only current week replies from a subset of vendors; CRA OOR is all open orders). Vendor-name overlap alone is not a meaningful bug signal. The real diagnostic is exact Part Number + Serial Number match under a different Order Number for the same vendor - zero such duplicates found."}, {"id": "concept_playwright_codegen_workflow", "label": "Playwright Codegen with Storage State Workflow", "file_type": "concept", "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Write-path addendum, storage state section", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_session_management", "label": "MXI Session Management - Login-Once, Retry-Once-Then-Halt", "file_type": "rationale", "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "mxiClient.ts spec section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Login/session loss is categorically different from a per-order data problem. A failed login at startup does not crash the server - it logs loudly and puts the client in a failed state. GET /health, GET /pending-esd-updates, and POST /reject still work without MXI, while POST /approve fails immediately with a clear error recorded as an audit row."}, {"id": "concept_write_verify_distinction", "label": "Write Reporting Failure vs Record Being Wrong Are Different Facts", "file_type": "rationale", "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Write path corruption incident section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "writeEsd's read-back check correctly caught mismatches and reported failure, but the corrupted value had already been submitted to the live stage record. A write reporting failure and a record being left in a wrong state are two different facts - checking only the former misses corrupted live data."}], "edges": [{"source": "backend_src_cli_ts", "target": "backend_src_matching_orphandiagnostics_ts", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Orphan-rate diagnostic section", "weight": 1.0}, {"source": "backend_src_mxiwriter_writeesd_ts", "target": "backend_src_mxiwriter_selectors_ts", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "writeEsd.ts spec section", "weight": 1.0}, {"source": "backend_src_mxiwriter_mxiclient_ts", "target": "backend_src_mxiwriter_selectors_ts", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "mxiClient.ts spec section", "weight": 1.0}, {"source": "backend_src_server_ts", "target": "backend_src_db_db_ts", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "HTTP server spec - getPendingEsdUpdates, insertMxiWrite", "weight": 1.0}, {"source": "concept_mxi_writer_safety", "target": "backend_src_mxiwriter_config_ts", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Safety rules section", "weight": 1.0}, {"source": "concept_mxi_writer_safety", "target": "backend_src_mxiwriter_writeesd_ts", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Safety rules section", "weight": 1.0}, {"source": "concept_append_only_audit", "target": "backend_src_db_schema_sql", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "DB schema section", "weight": 1.0}, {"source": "concept_fill_vs_keypress", "target": "backend_src_mxiwriter_selectors_ts", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Write path addendum - updateEsdField corruption bug section", "weight": 1.0}, {"source": "concept_orphan_rate_diagnostic", "target": "backend_src_matching_orphandiagnostics_ts", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "Orphan-rate diagnostic section", "weight": 1.0}, {"source": "concept_session_management", "target": "backend_src_mxiwriter_mxiclient_ts", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/PHASE2_MXI_WRITER_SPEC.md", "source_location": "mxiClient.ts spec section", "weight": 1.0}, {"source": "concept_playwright_codegen_workflow", "target": "backend_