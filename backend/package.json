{
  "name": "amc-repair-suite-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phase 1 ESD inference engine for PSA Airlines component repair open orders.",
  "scripts": {
    "diag:inhouse-scrap": "tsx src/cli/inHouseScrapProbeCli.ts",
    "diag:usage-table": "tsx src/cli/usageTableProbeCli.ts",
    "diag:api-reachability": "tsx src/cli/apiReachabilityCli.ts",
    "cli": "tsx src/cli/cli.ts",
    "server": "tsx src/server.ts",
    "server:codespaces": "xvfb-run -a npm run server",
    "mxi:read-esd": "tsx src/cli/mxiReadEsd.ts",
    "mxi:write-esd": "tsx src/cli/mxiWriteEsd.ts",
    "mxi:save-storage-state": "tsx src/mxiWriter/saveStorageState.ts",
    "aero-repair:write-up": "tsx src/cli/aeroRepairWriteUpCli.ts",
    "aero-repair:batch-discovery": "tsx src/cli/aeroRepairBatchDiscoveryCli.ts",
    "aero-repair:batch-execute": "tsx src/cli/aeroRepairBatchExecuteCli.ts",
    
    
    "aero-repair:review-pending": "tsx src/cli/aeroRepairReviewPendingCli.ts",
    "aero-repair:move-to-dock": "tsx src/cli/aeroRepairMoveToDockCli.ts",
    "aero-repair:approve-issue": "tsx src/cli/aeroRepairApproveIssueCli.ts",
    "aero-repair:reject-issue": "tsx src/cli/aeroRepairRejectIssueCli.ts",
    "api:discovery-runner": "tsx src/api/jobRunners/discoveryRunner.ts",
    "api:execute-runner": "tsx src/api/jobRunners/executeRunner.ts",
    "vendor:write-up": "tsx src/cli/vendorCodeWriteUpCli.ts",
    "vendor:batch-discovery": "tsx src/cli/vendorCodeBatchDiscoveryCli.ts",
    "vendor:batch-execute": "tsx src/cli/vendorCodeBatchExecuteCli.ts",
    "approve-and-write": "tsx src/cli/approveAndWrite.ts",
    "quote:ingest": "tsx src/cli/quoteIngestCli.ts",
    "quote:write": "tsx src/cli/quoteWriteCli.ts",
    "dock:audit": "tsx src/cli/dockAuditCli.ts",
    "scrap:price": "tsx src/cli/scrapPriceCli.ts",
    "rotate-encryption-key": "tsx src/security/rotateEncryptionKey.ts",
    "verify-gitignore": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-gitignore.ps1",
    "build": "tsc -b",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "better-sqlite3": "^11.3.0",
    "commander": "^12.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "mssql": "^12.7.0",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
