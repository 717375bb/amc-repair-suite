# #6-hardening, secrets-seam — which SecretProvider backend/src/security/
# secretProvider.ts uses. "local" (default) reads secrets from this .env
# file/the environment, same as always. "keyvault" is a future seam for an
# Azure Key Vault-backed provider — not implemented yet, setting it today
# throws a clear "not implemented" error rather than silently falling back.
SECRET_PROVIDER=local

ANTHROPIC_API_KEY=

# Phase 2 — MXI writer (used by server.ts)
# MXI_ENV defaults to "production" (per explicit user instruction,
# 2026-08-19 — stage as the default was confusing since it doesn't mirror
# production data). Set to "stage" explicitly here if you want that instead.
MXI_ENV=production
MXI_USERNAME=
MXI_PASSWORD=
# These two base URLs are the same for every PSA analyst (not secrets, just
# the real MXI login pages) — filled in here so a fresh clone works without
# having to hunt them down. Everything else in this file is per-analyst and
# stays blank on purpose.
MXI_STAGE_BASE_URL=https://stage.maintenix.psa.aa.com/maintenix/common/security/login.jsp
MXI_PROD_BASE_URL=https://maintenix.psa.aa.com/maintenix/common/security/login.jsp
DEFAULT_APPROVED_BY=

# Playwright launch mode for the MXI writer's browser. Default true (headless,
# no visible window). Set to exactly "false" to watch the browser for debugging.
HEADLESS=true

# CLI tools (npm run mxi:read-esd / mxi:write-esd / approve-and-write) —
# deliberately separate from MXI_USERNAME/MXI_PASSWORD above so these never
# depend on the HTTP server's writer credential config. Never populate these
# from a codegen recording file — type the real values in directly. Each
# tool defaults to production; pass --env stage to use the MXI_STAGE_ pair
# above instead.
# NOTE (#6, login/account system): when the WEB SERVER spawns an Order
# Write-Ups or ESD Finder job, it overrides these two pairs per-request with
# the currently logged-in user's own stored MXI credential — these .env
# values are never read for that path anymore. They're still exactly what
# the standalone CLI tools above use directly, unaffected.
MXI_STAGE_USERNAME=
MXI_STAGE_PASSWORD=
MXI_PROD_USERNAME=
MXI_PROD_PASSWORD=

# #6, login/account system — the local account store's master encryption
# key. Each user's real MXI password is stored encrypted (AES-256-GCM)
# under this key; the login-check itself uses a separate one-way hash
# (scrypt) that never needs this key at all. Generate a real 32-byte value
# locally (never reuse this placeholder, never commit the real value):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this key makes every already-stored MXI password
# undecryptable — back it up somewhere safe, separate from the DB file.
CREDENTIAL_ENCRYPTION_KEY=

# Optional, both have sensible defaults if omitted (see server.ts)
# PORT=3001
# MXI_DB_PATH=data/audit.db
# AUTH_DB_PATH=data/auth.db

# Shared-secret auth for GET /pending-esd-updates and POST /esd-updates/:orderNumber/{approve,reject}.
# Callers must send this exact value in an X-Automation-Key header. Generate a
# real random value locally (e.g. 32 random bytes, hex-encoded) — never reuse
# this placeholder, never commit the real value.
AUTOMATION_API_KEY=

# KPI database (Azure SQL, read-only credentials) — backend/src/kpiDb/
KPI_DB_SERVER=
KPI_DB_NAME=
KPI_DB_USER=
KPI_DB_PASSWORD=

# Vendor Quote Writer (docs/VENDOR_QUOTE_WRITER_SPEC.md) — the ONE Outlook
# folder the tool ever reads. Accepts either the mailbox-relative form
# ("Inbox\Quotes") or the full form Outlook itself displays
# ("\\you@example.com\Inbox\Quotes") — a redundant leading store name is
# stripped automatically. Reading is strictly read-only; the only mailbox
# change is marking a message read, and only after a verified MXI write.
QUOTES_FOLDER_PATH=Inbox\Quotes

# Vendor Quote Writer — approval replies to vendors.
# 'draft' (default) builds each reply and saves it to Outlook Drafts for you
# to review and send. 'send' sends immediately. ANY other value, including a
# typo or an unset variable, resolves to 'draft' — the failure direction is
# always "a draft you send yourself", never "an email already gone".
# The wording lives in backend/templates/quote-approval-reply.html; the
# system refuses to draft anything while that file still has its
# CLAUDE_TEMPLATE_NOT_CONFIGURED marker.
QUOTE_REPLY_MODE=draft

# Zero-times-and-cycles notifications to Maintenance Records (Order Write-Ups).
# 'draft' (default) saves the message to Outlook Drafts for you to review and
# send. 'send' sends immediately. ANY other value, including a typo or an
# unset variable, resolves to 'draft' — same failure direction as
# QUOTE_REPLY_MODE above. Recipient (DL_PSA_MaintenanceRecords) and subject
# ("Times and Cycles") are fixed in code, not configurable here.
MAINTENANCE_RECORDS_MODE=draft
