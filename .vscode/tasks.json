{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AMC: Start Backend",
      "type": "shell",
      "command": "npm run server",
      // MXI's Akamai edge blocks headless Chromium (confirmed — see
      // docs/CODESPACES.md). Codespaces containers have no real display,
      // so xvfb-run provides a virtual one for headed rendering. This
      // "linux" override only applies inside the container; local
      // Windows/macOS runs fall through to the plain command above.
      "linux": {
        "command": "xvfb-run -a npm run server"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "amc-repair-suite"
      },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "AMC: Start Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "amc-repair-suite"
      },
      "runOptions": { "runOn": "folderOpen" }
    }
  ]
}
